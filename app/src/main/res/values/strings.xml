    <string name="tips_title">Tips &amp; Help</string>
    <string name="tips_playback_category">Playback</string>
    <string name="tips_playback_category_summary">Queues, albums, and lyrics.</string>
    <string name="tips_library_category">Library</string>
    <string name="tips_library_category_summary">Find, rate, and organize your music.</string>
    <string name="tips_personalize_category">Personalize &amp; protect</string>
    <string name="tips_personalize_category_summary">Make the player yours and save app data.</string>
    <string name="tips_saved_queues_title">Saved queues</string>
    <string name="tips_saved_queues_body">Use Queue Hub to create separate saved listening queues and switch between them.</string>
    <string name="tips_play_next_title">Control what plays next</string>
    <string name="tips_play_next_body">Use Play Next to add music to the upcoming queue, or drag Queue Hub entries to reorder them.</string>
    <string name="tips_player_album_title">Open an album from the player</string>
    <string name="tips_player_album_body">In supported expanded-player themes, tap the album title to open that album in the Library.</string>
    <string name="tips_lyrics_title">Local lyrics</string>
    <string name="tips_lyrics_body">Open local lyrics from the expanded player when a matching lyrics file is available.</string>
    <string name="tips_quick_rate_title">Quick Rate</string>
    <string name="tips_quick_rate_body">Use Quick Rate in the Rated area to rate multiple songs efficiently.</string>
    <string name="tips_filters_title">Filters and fast scrolling</string>
    <string name="tips_filters_body">Filter your library by genre, year, or rating, and fast-scroll through supported long lists.</string>
    <string name="tips_smart_playlists_title">Smart Playlists</string>
    <string name="tips_smart_playlists_body">Create a Smart Playlist with your own rules; its songs update automatically.</string>
    <string name="tips_metadata_title">Edit metadata</string>
    <string name="tips_metadata_body">Open Edit tags from a song’s actions to correct supported music-file metadata.</string>
    <string name="tips_my_player_title">My Player</string>
    <string name="tips_my_player_body">My Player stores your custom look. Selecting a built-in preset preserves it; editing that preset saves the result as My Player.</string>
    <string name="tips_backup_title">Backup &amp; Restore</string>
    <string name="tips_backup_body">Export and restore supported app data. Restoring clears saved queues and current playback.</string>

