    <string name="usb_diagnostics_title">USB Audio / Bit-perfect diagnostics</string>
    <string name="usb_diagnostics_note">Development USB diagnostics. Direct USB playback is not implemented. Stop music before the Session 5 forced ownership experiment.</string>
    <string name="usb_diagnostics_force">Force-own AudioControl + read clock</string>
    <string name="usb_diagnostics_forcing">Testing forced AC ownership and recovery…</string>
    <string name="usb_diagnostics_kernel_result">Kernel bindings: %1$s</string>
    <string name="usb_diagnostics_framework_result">Android USB audio enumeration: %1$s</string>
    <string name="usb_diagnostics_bindings_restored">Restored</string>
    <string name="usb_diagnostics_bindings_not_restored">Not restored</string>
    <string name="usb_diagnostics_candidate_present">Candidate present</string>
    <string name="usb_diagnostics_candidate_missing">Candidate missing</string>
    <string name="usb_diagnostics_candidate_ambiguous">Candidate association ambiguous</string>
    <string name="usb_diagnostics_functional_not_verified">Functional USB audio playback: NOT VERIFIED</string>
    <string name="usb_diagnostics_post_force_warning">Development warning: kernel bindings and Android USB enumeration do not verify usable audio routing or DAC playback. If audio routes to the phone speaker or the DAC behaves abnormally, physically disconnect and reconnect the DAC before continuing.</string>
    <string name="usb_diagnostics_manual_ka15_note">Known manual KA15/Samsung test evidence, not automatically detected: repeated forced AudioControl ownership left playback on the phone speaker despite restored enumeration. Physical disconnect/reconnect restored DAC playback. This was observed in that environment; it is not a universal rule for USB DACs. HID controls working does not prove audio playback works.</string>
    <string name="usb_diagnostics_force_note">Session 5: stop all music first. This temporarily detaches Android’s USB-audio driver from AudioControl; the DAC may disappear from Android audio routing. No USB audio data is sent. AudioControl is released immediately after the clock reads, then recovery is observed for up to 2 seconds. Run Inspect kernel USB ownership first.</string>
    <string name="usb_diagnostics_service_unavailable">Playback service is unavailable. Reopen Sazanami and wait for playback to connect.</string>
    <string name="usb_diagnostics_refresh">Refresh USB devices / descriptors</string>
    <string name="usb_diagnostics_permission">Grant USB access for inspection</string>
    <string name="usb_diagnostics_copy">Copy USB audio report</string>
    <string name="usb_diagnostics_copied">USB audio report copied, including raw descriptor evidence.</string>
    <string name="usb_diagnostics_unnamed">USB device</string>
    <string name="usb_diagnostics_query_clock">Query UAC2 clock capabilities</string>
    <string name="usb_diagnostics_querying_clock">Reading UAC2 clock capabilities…</string>
    <string name="usb_diagnostics_test_claim">Test AudioControl claim + clock reads</string>
    <string name="usb_diagnostics_testing_claim">Testing AudioControl claim + clock reads…</string>
    <string name="usb_diagnostics_claim_note">Diagnostic experiment: temporary AudioControl ownership with force=false, read-only clock queries, then release. No USB playback.</string>
    <string name="usb_diagnostics_inspect_kernel">Inspect kernel USB ownership</string>
    <string name="usb_diagnostics_inspecting_kernel">Inspecting kernel USB ownership…</string>
    <string name="usb_diagnostics_kernel_note">Diagnostic only: kernel drivers, actual USB speed, one non-forced AudioControl claim with immediate release, and Android USB output capabilities. No driver detach or playback.</string>
