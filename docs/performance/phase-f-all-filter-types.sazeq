{
  "kind": "sazanami-parametric-eq-preset",
  "version": 1,
  "name": "Phase F All Filter Types",
  "preampDb": -6.0,
  "automaticHeadroomEnabled": true,
  "filters": [
    {
      "id": "phase-f-peaking",
      "enabled": true,
      "type": "PEAKING",
