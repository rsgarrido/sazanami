    },
    {
      "id": "phase-f-low-pass",
      "enabled": true,
      "type": "LOW_PASS",
      "frequencyHz": 14000.0,
      "q": 0.71
    },
    {
      "id": "phase-f-high-pass",
      "enabled": true,
      "type": "HIGH_PASS",
